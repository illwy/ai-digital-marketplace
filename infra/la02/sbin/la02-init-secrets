#!/bin/sh
# Generate LA02 node-secrets.json and U001 users.json on the server.
# Writes 0600 files only. Does not print secrets.
set -eu
umask 077

if [ "$(id -u)" -ne 0 ]; then
  echo "la02-init-secrets: must run as root" >&2
  exit 1
fi

DATA_DIR="${LA02_DATA_DIR:-/etc/sing-box/data}"
FQDN="${LA02_FQDN:-la02.k8izuh.com}"
HANDSHAKE="${REALITY_HANDSHAKE_HOST:-www.cloudflare.com}"
SERVER_IPV4="${LA02_SERVER_IPV4:-}"
TMP="$(mktemp -d /tmp/la02-init.XXXXXX)"
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT INT HUP

if [ -z "$SERVER_IPV4" ]; then
  SERVER_IPV4="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
fi
if ! printf '%s' "$SERVER_IPV4" | grep -qE '^[0-9]+(\.[0-9]+){3}$'; then
  echo "la02-init-secrets: unable to determine server IPv4" >&2
  exit 1
fi

if [ -f "$DATA_DIR/node-secrets.json" ] || [ -f "$DATA_DIR/users.json" ]; then
  echo "la02-init-secrets: refusing to overwrite existing data files" >&2
  exit 1
fi

install -d -m 700 "$DATA_DIR"
sing-box generate reality-keypair > "$TMP/keypair"
PRIVATE_KEY="$(awk '/PrivateKey/{print $2}' "$TMP/keypair")"
PUBLIC_KEY="$(awk '/PublicKey/{print $2}' "$TMP/keypair")"
SHORT_ID="$(openssl rand -hex 8)"
USER_UUID="$(sing-box generate uuid)"
USER_HY2_PASSWORD="$(openssl rand -base64 32 | tr -d '\n')"
CREATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ -z "$PRIVATE_KEY" ] || [ -z "$PUBLIC_KEY" ] || [ -z "$SHORT_ID" ] || [ -z "$USER_UUID" ] || [ -z "$USER_HY2_PASSWORD" ]; then
  echo "la02-init-secrets: generation failed" >&2
  exit 1
fi

python3 - "$DATA_DIR" "$SERVER_IPV4" "$PRIVATE_KEY" "$PUBLIC_KEY" "$SHORT_ID" "$FQDN" "$HANDSHAKE" "$USER_UUID" "$USER_HY2_PASSWORD" "$CREATED_AT" <<'PY'
import json, os, sys
data_dir, server_ipv4, private_key, public_key, short_id, fqdn, handshake, uuid, hy2, created = sys.argv[1:]
secrets = {
    "schema_version": 1,
    "node_id": "LA02",
    "server_ipv4": server_ipv4,
    "node_fqdn": fqdn,
    "reality": {
        "private_key": private_key,
        "public_key": public_key,
        "short_id": short_id,
        "handshake_host": handshake,
        "handshake_port": 443,
    },
}
users = {
    "schema_version": 1,
    "node_id": "LA02",
    "capacity": 10,
    "users": [
        {
            "user_id": "U001",
            "enabled": True,
            "vless_uuid": uuid,
            "hy2_password": hy2,
            "created_at": created,
            "expires_at": None,
            "note": None,
        }
    ],
}
for name, payload in ("node-secrets.json", secrets), ("users.json", users):
    path = os.path.join(data_dir, name)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2)
        fh.write("\n")
PY

echo "la02-init-secrets: wrote 0600 data files; values not printed"
