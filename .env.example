MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=marketplace
MYSQL_USER=marketplace
MYSQL_PASSWORD=marketplace
MYSQL_ROOT_PASSWORD=rootpass
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost

# Required. At least 32 characters. Do not use change-me placeholders.
JWT_SECRET=replace-this-dev-jwt-secret-key-min-32b

# Required to seed the first admin. At least 10 characters. Not admin123456.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-admin-password

# 支付宝电脑网站支付（待填写）。JAVA 使用 PKCS#8 应用私钥。不要把密钥提交进仓库或发到对话。
# 沙箱网关默认即可；正式环境改为 https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL_BASE=http://localhost:8088
ALIPAY_SELLER_ID=

# 2S-UI 节点开通（生产环境只给后端服务设置，不要提交真实 Token）
NODE_2SUI_ENABLED=false
NODE_2SUI_API_BASE_URL=https://panel.example.com
NODE_2SUI_WEB_PATH=/app/
NODE_2SUI_API_TOKEN=
# Public HTTP subscription endpoint, e.g. https://sub.example.com/sub/{clientId}
NODE_SUBSCRIPTION_URL_TEMPLATE=https://sub.k8izuh.com/sub/{clientName}
