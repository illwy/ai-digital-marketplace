MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=marketplace
MYSQL_USER=marketplace
MYSQL_PASSWORD=marketplace
MYSQL_ROOT_PASSWORD=rootpass
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost

# Required. At least 32 characters. Do not use change-me placeholders.
JWT_SECRET=replace-this-dev-jwt-secret-key-min-32b

# Required to seed the first admin. At least 10 characters. Not admin123456.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-admin-password
